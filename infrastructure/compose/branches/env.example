# MARA AI-ETC — Contoh konfigurasi .env per-cawangan (COMMITTED, selamat).
#
# Salin ke .env.<kod_cawangan> dan isi nilai sebenar.
# Fail .env.* adalah gitignored — jangan commit kata laluan sebenar.
#
#   cp infrastructure/compose/branches/env.example.example \
#      infrastructure/compose/branches/.env.sel
#   # kemaskini nilai, kemudian:
#   docker compose -f infrastructure/compose/branches/docker-compose.branch.yml \
#     --env-file infrastructure/compose/branches/.env.sel up -d

# ── Master .env (untuk docker-compose.stack.yml) ─────────────
# Hanya satu pembolehubah diperlukan:
#   DB_PASSWORD=<kata_laluan_selamat>

# ── .env per-cawangan (untuk docker-compose.branch.yml) ──────
# Kod cawangan (hq, sel, kel, joh, prk, trg, nsn, kdh, national)
BRANCH_CODE=sel
BRANCH_NAME="Cawangan Selangor"
# Port hos untuk dipetakan ke 5432 dalam kontena
PORT_PRIMARY=5433
# Kata laluan database — GANTI dengan nilai selamat, jangan commit
DB_PASSWORD=REPLACE_ME_WITH_SECURE_PASSWORD
# DSN untuk API Gateway cawangan ini.
# NOTE: aksara khas dalam kata laluan perlu URL-encode (@ -> %40)
MARA_DATABASE__PRIMARY_DSN=postgresql+asyncpg://mara:REPLACE_ME_WITH_SECURE_PASSWORD@localhost:5433/mara_sel
MARA_BRANCH_CODE=sel