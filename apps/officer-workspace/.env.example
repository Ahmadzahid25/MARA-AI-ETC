# MARA AI-ETC Officer Workspace — Environment Variables
# Copy this file to .env.local and update values for your environment.
#
# For local dev with Docker stack running:
#   cp .env.example .env.local
#
# For dev mode WITHOUT Keycloak (mock login):
#   Leave these unset — defaults will be used and Mock login still works.

# ---------------------------------------------------------------------------
# Keycloak / OIDC Configuration
# ---------------------------------------------------------------------------

# Base URL of the Keycloak server (no trailing slash)
VITE_KEYCLOAK_URL=http://localhost:8080

# Keycloak realm name (must match realm in infrastructure/compose/init/)
VITE_KEYCLOAK_REALM=mara-ai-etc

# OIDC client ID (must match "clientId" in the realm JSON)
VITE_KEYCLOAK_CLIENT_ID=mara-officer-workspace

# ---------------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------------

# Vite dev proxy target — API Gateway backend (services/api_gateway/)
# Change this if API Gateway runs on a different port.
# (This is set in vite.config.ts directly; override here only if needed.)
# VITE_API_GATEWAY_URL=http://localhost:8051
