# MARA AI-ETC — Root Environment Variables Template
# COPY THIS FILE TO `.env` OR `.env.local` FOR LOCAL DEVELOPMENT.
# DO NOT COMMIT ACTUAL API KEYS OR SECRETS TO GIT!

# ---------------------------------------------------------------------------
# LLM / AI Model Provider Configuration
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------------------
# Database & Storage
# ---------------------------------------------------------------------------
DATABASE_PRIMARY_URL=postgresql://postgres:REPLACE_ME_DEV_ONLY@localhost:5432/mara_primary
DATABASE_DIFY_URL=postgresql://postgres:REPLACE_ME_DEV_ONLY@localhost:5433/dify

# ---------------------------------------------------------------------------
# Keycloak SSO
# ---------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mara-ai-etc
KEYCLOAK_CLIENT_ID=mara-officer-workspace
